#!/usr/bin/env bash
set -euo pipefail

if [[ "${DEVFLOW_SKIP_HOOKS:-}" == "1" ]]; then
  echo "DEVFLOW_SKIP_HOOKS=1: skipping pre-push checks" >&2
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "${ROOT}"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [[ "${remote_ref}" == "refs/heads/main" || "${remote_ref}" == "refs/heads/master" ]]; then
    echo "direct push to main is blocked; open a pull request" >&2
    exit 1
  fi
done

./scripts/verify

if [[ -d "${ROOT}/.venv/Scripts" ]]; then
  PATH="${ROOT}/.venv/Scripts:${PATH}"
fi
if [[ -d "${ROOT}/.venv/bin" ]]; then
  PATH="${ROOT}/.venv/bin:${PATH}"
fi
export PATH

if ! command -v devflow >/dev/null 2>&1; then
  echo "warning: devflow is not installed; skipping ci-checks" >&2
  exit 0
fi
devflow ci-checks
